{
  "name": "newzpage",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "An RSS reader that typesets your feeds as the front page of an old newspaper.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "summarize": "node --import tsx --no-warnings=ExperimentalWarning src/lib/summarize/cli.ts",
    "directory": "node --import tsx --no-warnings=ExperimentalWarning scripts/build-directory.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@vercel/analytics": "^2.0.1",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^30.0.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9"
  }
}
