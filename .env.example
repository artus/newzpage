# The house defaults handed to first-time readers (default: ./feeds.json)
# NEWZPAGE_FEEDS_FILE=./feeds.json

# Comma-separated feed URLs that replace the default feeds from feeds.json
# NEWZPAGE_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://news.ycombinator.com/rss

# Allow the server to fetch private/local addresses (only for a home network)
# NEWZPAGE_ALLOW_PRIVATE_URLS=1

# How many article pages are fetched at the same time (default: 6)
# NEWZPAGE_CONCURRENCY=6

# debug | info | warn | error (default: info)
# NEWZPAGE_LOG_LEVEL=info

# Feed search in the composing room: "feedly" (default) also asks feedly.com's public search,
# "directory" only searches the bundled directory and site addresses
# NEWZPAGE_FEED_SEARCH=feedly
